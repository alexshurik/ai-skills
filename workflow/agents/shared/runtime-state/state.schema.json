{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sk-skills.local/runtime-state/state.schema.json",
  "title": "SK workflow materialized state v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "revision",
    "run",
    "repositories",
    "workflow",
    "control",
    "artifacts",
    "blockers",
    "last_event"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "revision": { "type": "integer", "minimum": 1 },
    "run": { "$ref": "#/$defs/run" },
    "repositories": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "$ref": "#/$defs/repository" }
    },
    "workflow": { "$ref": "#/$defs/workflow" },
    "control": { "$ref": "#/$defs/control" },
    "artifacts": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "$ref": "#/$defs/artifact" }
    },
    "blockers": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "$ref": "#/$defs/blocker" }
    },
    "last_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seq", "id"],
      "properties": {
        "seq": { "type": "integer", "minimum": 1 },
        "id": { "$ref": "#/$defs/identifier" }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+\\-]*$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "change", "workflow", "policy_revision", "created_at"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "change": { "$ref": "#/$defs/identifier" },
        "workflow": { "$ref": "#/$defs/identifier" },
        "policy_revision": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "format": "date-time" },
        "migrated_from": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version"],
          "properties": { "schema_version": { "const": 1 } }
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "root": { "type": "string", "minLength": 1 },
        "worktree": { "type": "string", "minLength": 1 },
        "branch": { "type": "string", "minLength": 1 },
        "base_sha": { "type": "string", "minLength": 1 }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_stage", "stages"],
      "properties": {
        "current_stage": { "oneOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }] },
        "stages": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": { "$ref": "#/$defs/stage" }
        }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "entries", "gates", "checks", "tasks"],
      "properties": {
        "status": {
          "enum": ["pending", "in_progress", "waiting", "succeeded", "failed", "skipped"]
        },
        "entries": { "type": "integer", "minimum": 0 },
        "entered_event": { "type": "integer", "minimum": 0 },
        "completed_event": { "type": "integer", "minimum": 0 },
        "gates": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": { "$ref": "#/$defs/gate" }
        },
        "checks": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": { "$ref": "#/$defs/check" }
        },
        "tasks": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": { "$ref": "#/$defs/task" }
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason", "entry", "requested_event"],
      "properties": {
        "status": { "enum": ["pending", "approved", "rejected", "waived"] },
        "reason": { "type": "string", "minLength": 1 },
        "entry": { "type": "integer", "minimum": 1 },
        "requested_event": { "type": "integer", "minimum": 0 },
        "decided_by": { "type": "string", "minLength": 1 },
        "decision_event": { "type": "integer", "minimum": 0 },
        "decision_reason": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "pending" } }, "required": ["status"] },
          "then": { "not": { "anyOf": [{ "required": ["decided_by"] }, { "required": ["decision_event"] }] } },
          "else": { "required": ["decided_by", "decision_event"] }
        }
      ]
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "entry", "recorded_event"],
      "properties": {
        "status": { "enum": ["passed", "failed", "unknown"] },
        "entry": { "type": "integer", "minimum": 1 },
        "recorded_event": { "type": "integer", "minimum": 0 },
        "evidence": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "status", "created_entry", "created_event", "attempts"],
      "properties": {
        "role": { "$ref": "#/$defs/identifier" },
        "status": { "enum": ["pending", "running", "succeeded", "failed", "blocked", "cancelled"] },
        "created_entry": { "type": "integer", "minimum": 1 },
        "created_event": { "type": "integer", "minimum": 0 },
        "attempts": { "type": "array", "items": { "$ref": "#/$defs/attempt" } }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ordinal", "status", "agent", "stage_entry", "started_event", "late_results"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "ordinal": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["running", "succeeded", "failed", "blocked", "cancelled"] },
        "agent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "host_thread_id"],
          "properties": {
            "role": { "$ref": "#/$defs/identifier" },
            "host_thread_id": { "type": "string", "minLength": 1 }
          }
        },
        "input_fingerprint": { "$ref": "#/$defs/sha256" },
        "stage_entry": { "type": "integer", "minimum": 1 },
        "started_event": { "type": "integer", "minimum": 0 },
        "result": { "$ref": "#/$defs/result" },
        "late_results": { "type": "array", "items": { "$ref": "#/$defs/late_result" } }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "recorded_event"],
      "properties": {
        "outcome": { "enum": ["succeeded", "failed", "blocked", "cancelled"] },
        "recorded_event": { "type": "integer", "minimum": 0 },
        "verdict": { "type": "string", "minLength": 1 },
        "artifact": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "late_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recorded_event"],
      "properties": {
        "recorded_event": { "type": "integer", "minimum": 1 },
        "verdict": { "type": "string", "minLength": 1 },
        "artifact": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "recorded_event"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "recorded_event": { "type": "integer", "minimum": 0 },
        "kind": { "$ref": "#/$defs/identifier" },
        "stage": { "$ref": "#/$defs/identifier" }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "required_action", "recorded_event"],
      "properties": {
        "reason": { "type": "string", "minLength": 1 },
        "required_action": { "type": "string", "minLength": 1 },
        "recorded_event": { "type": "integer", "minimum": 0 }
      }
    },
    "control": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reason_code"],
          "properties": {
            "kind": { "const": "ready" },
            "reason_code": { "$ref": "#/$defs/identifier" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "join", "attempt_ids", "reason_code"],
          "properties": {
            "kind": { "const": "waiting_agents" },
            "join": { "enum": ["foreground", "detached"] },
            "attempt_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/identifier" }
            },
            "reason_code": { "$ref": "#/$defs/identifier" },
            "detach_reason": { "$ref": "#/$defs/identifier" }
          },
          "allOf": [
            {
              "if": { "properties": { "join": { "const": "detached" } }, "required": ["join"] },
              "then": { "required": ["detach_reason"] },
              "else": { "not": { "required": ["detach_reason"] } }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "gate_ids", "reason_code"],
          "properties": {
            "kind": { "const": "waiting_user" },
            "gate_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[^/]+/[^/]+$" }
            },
            "reason_code": { "$ref": "#/$defs/identifier" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "blocker_ids"],
          "properties": {
            "kind": { "const": "blocked" },
            "blocker_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/identifier" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "outcome"],
          "properties": {
            "kind": { "const": "complete" },
            "outcome": { "enum": ["completed", "aborted"] }
          }
        }
      ]
    }
  }
}
